<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Lock Screen countdown asks to be a Live Update on Android 16 (widgets/MeetingCountdown.kt). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Meeting warnings (MeetingWarnings.kt): exact when the person allows it, and kept across a reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- App Lock (lock/AppLock.kt): the platform BiometricPrompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The phone's own calendars (workspace/calendar/DeviceCalendars.kt), asked for only after Include local calendars. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Guest completions from the phone's Contacts (workspace/calendar/DeviceContacts.kt), asked when a guest field first opens. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".StarlingsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_lime"
        android:roundIcon="@mipmap/ic_launcher_lime"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- The launcher entry is one of the app-icon aliases below. -->
            <!-- Room links, verified App Links (#1238): each workspace host serves
                 /.well-known/assetlinks.json naming this package and its certificate. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="envisioning.starlings.example" android:pathPrefix="/room/" />
                <!-- Room links for another workspace (slice F): the app offers to open them there. -->
                <data android:scheme="https" android:host="*.starlings.example" android:pathPrefix="/room/" />
            </intent-filter>
            <!-- The app's own links (AppLinks.kt): starlings://, and meet:// from before the rename. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="starlings" />
                <data android:scheme="meet" />
            </intent-filter>
            <!-- The workspace sign-in's callback (ANDROID_NATIVE_SIGN_IN_CALLBACK). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="work.starlings.android" />
            </intent-filter>
        </activity>

        <!--
          The launcher entries, one per iOS app icon (workspace/settings/AppIcon.kt,
          iOS/MobileAppIcon.swift). Exactly one is enabled; Settings › Appearance ›
          App icon switches them. The names never change: the launcher keys on them.
        -->
        <activity-alias
            android:name=".IconLime"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lime"
            android:roundIcon="@mipmap/ic_launcher_lime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconGraphiteLime"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite_lime"
            android:roundIcon="@mipmap/ic_launcher_graphite_lime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconGraphiteWhite"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite_white"
            android:roundIcon="@mipmap/ic_launcher_graphite_white">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- The share target (share/ShareActivity.kt): a shared link saves to Docs, shared text is a Quick Note. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The App Lock cover (lock/LockActivity.kt), above whatever is open. -->
        <activity
            android:name=".lock.LockActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
        <!-- Home-screen widgets (widgets/): Upcoming, Today's agenda, Today's work, as iOSActivities. -->
        <receiver android:name=".widgets.NextMeetingWidgetReceiver" android:exported="false" android:label="@string/widget_next_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next" />
        </receiver>
        <receiver android:name=".widgets.TodayAgendaWidgetReceiver" android:exported="false" android:label="@string/widget_agenda_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda" />
        </receiver>
        <receiver android:name=".widgets.TodayWorkWidgetReceiver" android:exported="false" android:label="@string/widget_work_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_work" />
        </receiver>
        <!-- Quick Settings tiles (widgets/Controls.kt): Join meeting and Quick note, as iOSActivities' controls. -->
        <service
            android:name=".widgets.JoinMeetingTile"
            android:exported="true"
            android:icon="@drawable/widget_ic_video"
            android:label="@string/control_join_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".widgets.QuickNoteTile"
            android:exported="true"
            android:icon="@drawable/control_ic_note"
            android:label="@string/control_note_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <receiver android:name=".MeetingWarningReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".widgets.MeetingCountdownReceiver" android:exported="false" />
    </application>
</manifest>
