{
  "name": "meet-envisioning",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "./scripts/local-dev.sh",
    "dev:ios": "./scripts/local-dev-ios.sh",
    "dev:web": "pnpm --filter @starlings/web dev",
    "dev:api": "pnpm --filter @starlings/control-plane dev",
    "build:web": "pnpm --filter @starlings/web build && node ./scripts/check-web-entry-budget.mjs",
    "generate:web-icons": "pnpm --filter @starlings/web generate:icons",
    "sync:country-flags": "node ./scripts/sync-country-flags.mjs",
    "test:api": "pnpm --filter @starlings/control-plane test",
    "test:web": "pnpm --filter @starlings/web test",
    "test:suggestions": "node ./services/control-plane/scripts/eval-suggestions.ts",
    "eval:jev": "node ./services/control-plane/scripts/eval-jev-filing.ts",
    "typecheck:api": "pnpm --filter @starlings/control-plane typecheck",
    "verify:fast": "./scripts/verify-fast.sh",
    "verify:changed": "./scripts/verify-changed.sh",
    "issue-refs": "node ./scripts/report-issue-refs.mjs",
    "land:status": "./scripts/land-status.sh",
    "github:app:create": "node scripts/github-app-create.mjs",
    "worktrees:sweep": "./scripts/worktrees-sweep.sh",
    "contracts:emit": "node --import ./scripts/node-ts-resolve.mjs ./packages/contracts/scripts/emit-schema.ts",
    "contracts:swift": "node ./scripts/gen-swift-contracts.mjs",
    "contracts:kotlin": "node ./scripts/gen-kotlin-contracts.mjs",
    "contracts:gen": "pnpm contracts:emit && pnpm contracts:swift && pnpm contracts:kotlin",
    "hotspots": "node ./scripts/code-hotspots.mjs",
    "registries:gen": "node --import ./scripts/node-ts-resolve.mjs ./scripts/gen-swift-registries.mjs --write",
    "registries:check": "node --import ./scripts/node-ts-resolve.mjs ./scripts/gen-swift-registries.mjs --check",
    "standard:check": "node --import ./scripts/node-ts-resolve.mjs ./scripts/check-standard-conformance.mjs",
    "contracts:check": "pnpm contracts:emit --check && pnpm contracts:swift --check && pnpm contracts:kotlin --check && pnpm registries:check",
    "contracts:test": "node --import ./scripts/node-ts-resolve.mjs --test packages/contracts/scripts/gen-swift.test.mjs packages/contracts/scripts/gen-kotlin.test.mjs packages/contracts/scripts/thread-replies.test.mjs packages/contracts/scripts/gen-swift-registries.test.mjs",
    "openapi:gen": "node --import ./scripts/node-ts-resolve.mjs ./packages/contracts/scripts/emit-mcp-openapi-schemas.ts && node web/scripts/mcp-discovery.mjs --write-openapi",
    "openapi:check": "node --import ./scripts/node-ts-resolve.mjs ./packages/contracts/scripts/emit-mcp-openapi-schemas.ts --check && node web/scripts/mcp-discovery.mjs --check-openapi",
    "docs:check": "node --import ./scripts/node-ts-resolve.mjs ./scripts/check-docs.mjs --strict && node ./scripts/gen-doc-map.mjs --check && node --import ./scripts/node-ts-resolve.mjs ./scripts/gen-glossary.mjs --check",
    "docs:map": "node ./scripts/gen-doc-map.mjs && node --import ./scripts/node-ts-resolve.mjs ./scripts/gen-glossary.mjs",
    "smoke:api": "node ./scripts/smoke-control-plane.mjs",
    "fixtures:responses": "node ./scripts/record-response-fixtures.mjs",
    "probe:crm": "node ./scripts/crm-probe.mjs",
    "dev:host-simulator": "node ./scripts/local-host-simulator.mjs",
    "deploy": "node ./scripts/check-production-config.mjs && pnpm build:web && pnpm --filter @starlings/control-plane deploy",
    "deploy:dry": "pnpm build:web && pnpm --filter @starlings/control-plane deploy:dry",
    "deploy:ops": "pnpm --filter @starlings/control-plane deploy:ops",
    "deploy:ops:dry": "pnpm --filter @starlings/control-plane deploy:ops:dry",
    "verify": "./scripts/verify.sh",
    "verify:release": "./scripts/verify.sh --release",
    "build:marketing": "node ./scripts/build-marketing.mjs"
  }
}
