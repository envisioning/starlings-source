{
  "version": 1,
  "rule": "ThreadMarkdown (Sources/ThreadMarkdown.swift) and parseMarkdown (web/src/markdown-parse.ts): a message in, its blocks out. Spans list only the marks that are on.",
  "cases": [
    {"name": "empty", "in": "", "out": []},
    {"name": "blank lines only", "in": "\n  \n\t\n", "out": []},
    {"name": "plain paragraph", "in": "Hello world", "out": [{"kind": "paragraph", "spans": [{"text": "Hello world"}]}]},
    {"name": "wrapped lines stay one paragraph", "in": "first line\nsecond line\n\nnext paragraph", "out": [{"kind": "paragraph", "spans": [{"text": "first line\nsecond line"}]}, {"kind": "paragraph", "spans": [{"text": "next paragraph"}]}]},
    {"name": "crlf line endings", "in": "one\r\ntwo\r\n\r\n- item\r\n", "out": [{"kind": "paragraph", "spans": [{"text": "one\ntwo"}]}, {"kind": "bullet", "level": 0, "spans": [{"text": "item"}]}]},
    {"name": "headings clamp at level 3", "in": "# One\n## Two\n### Three\n#### Four\n###### Six", "out": [{"kind": "heading", "level": 1, "spans": [{"text": "One"}]}, {"kind": "heading", "level": 2, "spans": [{"text": "Two"}]}, {"kind": "heading", "level": 3, "spans": [{"text": "Three"}]}, {"kind": "heading", "level": 3, "spans": [{"text": "Four"}]}, {"kind": "heading", "level": 3, "spans": [{"text": "Six"}]}]},
    {"name": "seven hashes is not a heading", "in": "####### too deep", "out": [{"kind": "paragraph", "spans": [{"text": "####### too deep"}]}]},
    {"name": "a tag is not a heading", "in": "#tag and #another", "out": [{"kind": "paragraph", "spans": [{"text": "#tag and #another"}]}]},
    {"name": "heading needs text after the space", "in": "# \n#", "out": [{"kind": "paragraph", "spans": [{"text": "#\n#"}]}]},
    {"name": "bullets with three markers", "in": "- dash\n* star\n+ plus", "out": [{"kind": "bullet", "level": 0, "spans": [{"text": "dash"}]}, {"kind": "bullet", "level": 0, "spans": [{"text": "star"}]}, {"kind": "bullet", "level": 0, "spans": [{"text": "plus"}]}]},
    {"name": "bullet needs a space", "in": "-dash\n*star\n+plus", "out": [{"kind": "paragraph", "spans": [{"text": "-dash\n*star\n+plus"}]}]},
    {"name": "bullet nesting by indent", "in": "- a\n  - b\n    - c\n      - d\n\t- tab", "out": [{"kind": "bullet", "level": 0, "spans": [{"text": "a"}]}, {"kind": "bullet", "level": 1, "spans": [{"text": "b"}]}, {"kind": "bullet", "level": 2, "spans": [{"text": "c"}]}, {"kind": "bullet", "level": 2, "spans": [{"text": "d"}]}, {"kind": "bullet", "level": 1, "spans": [{"text": "tab"}]}]},
    {"name": "ordered lists", "in": "1. one\n2) two\n10. ten\n  3. nested", "out": [{"kind": "ordered", "level": 0, "number": 1, "spans": [{"text": "one"}]}, {"kind": "ordered", "level": 0, "number": 2, "spans": [{"text": "two"}]}, {"kind": "ordered", "level": 0, "number": 10, "spans": [{"text": "ten"}]}, {"kind": "ordered", "level": 1, "number": 3, "spans": [{"text": "nested"}]}]},
    {"name": "ordered needs a space and at most nine digits", "in": "1.one\n1234567890. big\n123456789. nine", "out": [{"kind": "paragraph", "spans": [{"text": "1.one\n1234567890. big"}]}, {"kind": "ordered", "level": 0, "number": 123456789, "spans": [{"text": "nine"}]}]},
    {"name": "quote", "in": "> quoted\n>tight\n> **bold** quote", "out": [{"kind": "quote", "spans": [{"text": "quoted"}]}, {"kind": "quote", "spans": [{"text": "tight"}]}, {"kind": "quote", "spans": [{"text": "bold", "bold": true}, {"text": " quote"}]}]},
    {"name": "fenced code keeps its lines", "in": "before\n```js\nconst a = 1;\n\n  indented\n```\nafter", "out": [{"kind": "paragraph", "spans": [{"text": "before"}]}, {"kind": "code", "text": "const a = 1;\n\n  indented"}, {"kind": "paragraph", "spans": [{"text": "after"}]}]},
    {"name": "tilde fence", "in": "~~~\n**not bold**\n~~~", "out": [{"kind": "code", "text": "**not bold**"}]},
    {"name": "unterminated fence ends the message", "in": "```\nhalf typed\nstill code", "out": [{"kind": "code", "text": "half typed\nstill code"}]},
    {"name": "fence marker inside a different fence", "in": "~~~\n```\n~~~\ntext", "out": [{"kind": "code", "text": "```"}, {"kind": "paragraph", "spans": [{"text": "text"}]}]},
    {"name": "bold and italic", "in": "**bold** *italic* _italic_ __bold__", "out": [{"kind": "paragraph", "spans": [{"text": "bold", "bold": true}, {"text": " "}, {"text": "italic", "italic": true}, {"text": " "}, {"text": "italic", "italic": true}, {"text": " "}, {"text": "bold", "bold": true}]}]},
    {"name": "bold italic with three markers", "in": "***both*** and ***shouty**", "out": [{"kind": "paragraph", "spans": [{"text": "both", "bold": true, "italic": true}, {"text": " and "}, {"text": "*shouty", "bold": true}]}]},
    {"name": "nested emphasis collapses into one run", "in": "**bold *and italic***", "out": [{"kind": "paragraph", "spans": [{"text": "bold *and italic", "bold": true}, {"text": "*"}]}]},
    {"name": "spaces inside markers are arithmetic", "in": "a * b * c and 5 * 6", "out": [{"kind": "paragraph", "spans": [{"text": "a * b * c and 5 * 6"}]}]},
    {"name": "snake_case survives", "in": "call snake_case_names and my_var_ here", "out": [{"kind": "paragraph", "spans": [{"text": "call snake_case_names and my_var_ here"}]}]},
    {"name": "unclosed marker is text", "in": "**never closed and *neither", "out": [{"kind": "paragraph", "spans": [{"text": "**never closed and *neither"}]}]},
    {"name": "strikethrough", "in": "~~gone~~ and ~single~", "out": [{"kind": "paragraph", "spans": [{"text": "gone", "strike": true}, {"text": " and ~single~"}]}]},
    {"name": "inline code", "in": "run `pnpm verify` then `**not bold**`", "out": [{"kind": "paragraph", "spans": [{"text": "run "}, {"text": "pnpm verify", "code": true}, {"text": " then "}, {"text": "**not bold**", "code": true}]}]},
    {"name": "unclosed backtick is text", "in": "a ` b", "out": [{"kind": "paragraph", "spans": [{"text": "a ` b"}]}]},
    {"name": "backslash escapes", "in": "\\*literal\\* and \\# and \\q", "out": [{"kind": "paragraph", "spans": [{"text": "*literal* and # and \\q"}]}]},
    {"name": "link", "in": "see [the docs](https://example.com/docs) now", "out": [{"kind": "paragraph", "spans": [{"text": "see "}, {"text": "the docs", "link": "https://example.com/docs"}, {"text": " now"}]}]},
    {"name": "link with emphasis in the label", "in": "[**bold** label](https://example.com)", "out": [{"kind": "paragraph", "spans": [{"text": "bold", "bold": true, "link": "https://example.com"}, {"text": " label", "link": "https://example.com"}]}]},
    {"name": "link label with a bracket", "in": "[a [b] c](https://example.com)", "out": [{"kind": "paragraph", "spans": [{"text": "a [b] c", "link": "https://example.com"}]}]},
    {"name": "mailto link", "in": "[mail me](mailto:ana@example.com)", "out": [{"kind": "paragraph", "spans": [{"text": "mail me", "link": "mailto:ana@example.com"}]}]},
    {"name": "unsafe schemes stay text", "in": "[x](javascript:alert(1)) [y](data:text/html,hi) [z](/relative) [w](file:///etc/passwd)", "out": [{"kind": "paragraph", "spans": [{"text": "[x](javascript:alert(1)) [y](data:text/html,hi) [z](/relative) [w](file:///etc/passwd)"}]}]},
    {"name": "link target with a space stays text", "in": "[x](https://example.com/a b)", "out": [{"kind": "paragraph", "spans": [{"text": "[x]("}, {"text": "https://example.com/a", "link": "https://example.com/a"}, {"text": " b)"}]}]},
    {"name": "bare urls", "in": "go to https://example.com/a?b=1 or www.example.com/x today", "out": [{"kind": "paragraph", "spans": [{"text": "go to "}, {"text": "https://example.com/a?b=1", "link": "https://example.com/a?b=1"}, {"text": " or "}, {"text": "www.example.com/x", "link": "https://www.example.com/x"}, {"text": " today"}]}]},
    {"name": "bare url keeps sentence punctuation out", "in": "See https://example.com/a. Or (https://example.com/b), or https://example.com/c!", "out": [{"kind": "paragraph", "spans": [{"text": "See "}, {"text": "https://example.com/a", "link": "https://example.com/a"}, {"text": ". Or ("}, {"text": "https://example.com/b", "link": "https://example.com/b"}, {"text": "), or "}, {"text": "https://example.com/c", "link": "https://example.com/c"}, {"text": "!"}]}]},
    {"name": "bare url keeps its own parenthesis", "in": "https://en.wikipedia.org/wiki/Foo_(bar) ok", "out": [{"kind": "paragraph", "spans": [{"text": "https://en.wikipedia.org/wiki/Foo_(bar)", "link": "https://en.wikipedia.org/wiki/Foo_(bar)"}, {"text": " ok"}]}]},
    {"name": "url inside a word is text", "in": "ahttps://example.com and see:https://example.com/x", "out": [{"kind": "paragraph", "spans": [{"text": "ahttps://example.com and see:"}, {"text": "https://example.com/x", "link": "https://example.com/x"}]}]},
    {"name": "bare scheme is not a link", "in": "https:// and www. alone", "out": [{"kind": "paragraph", "spans": [{"text": "https:// and www. alone"}]}]},
    {"name": "uppercase scheme", "in": "HTTPS://EXAMPLE.COM/PATH", "out": [{"kind": "paragraph", "spans": [{"text": "HTTPS://EXAMPLE.COM/PATH", "link": "HTTPS://EXAMPLE.COM/PATH"}]}]},
    {"name": "image syntax is not an image in a message", "in": "![diagram](https://example.com/a.png) after", "out": [{"kind": "paragraph", "spans": [{"text": "!"}, {"text": "diagram", "link": "https://example.com/a.png"}, {"text": " after"}]}]},
    {"name": "image syntax with an unsafe url", "in": "![x](javascript:alert(1))", "out": [{"kind": "paragraph", "spans": [{"text": "![x](javascript:alert(1))"}]}]},
    {"name": "html is text", "in": "<b>bold</b> <script>alert(1)</script>", "out": [{"kind": "paragraph", "spans": [{"text": "<b>bold</b> <script>alert(1)</script>"}]}]},
    {"name": "table row is text", "in": "| a | b |\n|---|---|\n| 1 | 2 |", "out": [{"kind": "paragraph", "spans": [{"text": "| a | b |\n|---|---|\n| 1 | 2 |"}]}]},
    {"name": "wikilink and footnote are text in a message", "in": "see [[Some page|label]] and [^1]", "out": [{"kind": "paragraph", "spans": [{"text": "see [[Some page|label]] and [^1]"}]}]},
    {"name": "non-latin text", "in": "**ø bold** and *斜体* and 李小龍", "out": [{"kind": "paragraph", "spans": [{"text": "ø bold", "bold": true}, {"text": " and "}, {"text": "斜体", "italic": true}, {"text": " and 李小龍"}]}]},
    {"name": "emphasis next to a letter in another script", "in": "_ñandú_ y x_ñ_", "out": [{"kind": "paragraph", "spans": [{"text": "ñandú", "italic": true}, {"text": " y x_ñ_"}]}]},
    {"name": "emoji and flags", "in": "**ok** 👩‍💻 🇳🇴 done", "out": [{"kind": "paragraph", "spans": [{"text": "ok", "bold": true}, {"text": " 👩‍💻 🇳🇴 done"}]}]},
    {"name": "mixed message", "in": "## Plan\n\n1. Ship **today**\n2. Check [the build](https://example.com/b)\n\n> note: `pnpm verify`\n\n- done ~~yesterday~~", "out": [{"kind": "heading", "level": 2, "spans": [{"text": "Plan"}]}, {"kind": "ordered", "level": 0, "number": 1, "spans": [{"text": "Ship "}, {"text": "today", "bold": true}]}, {"kind": "ordered", "level": 0, "number": 2, "spans": [{"text": "Check "}, {"text": "the build", "link": "https://example.com/b"}]}, {"kind": "quote", "spans": [{"text": "note: "}, {"text": "pnpm verify", "code": true}]}, {"kind": "bullet", "level": 0, "spans": [{"text": "done "}, {"text": "yesterday", "strike": true}]}]},
    {"name": "nested quote marker", "in": ">> inner\n> > spaced", "out": [{"kind": "quote", "spans": [{"text": "> inner"}]}, {"kind": "quote", "spans": [{"text": "> spaced"}]}]},
    {"name": "heading holds inline marks", "in": "# **Bold** title with `code`", "out": [{"kind": "heading", "level": 1, "spans": [{"text": "Bold", "bold": true}, {"text": " title with "}, {"text": "code", "code": true}]}]},
    {"name": "link with a title stays text", "in": "[a](https://example.com \"title\")", "out": [{"kind": "paragraph", "spans": [{"text": "[a]("}, {"text": "https://example.com", "link": "https://example.com"}, {"text": " \"title\")"}]}]},
    {"name": "link target in angle brackets stays text", "in": "[a](<https://example.com>)", "out": [{"kind": "paragraph", "spans": [{"text": "[a](<"}, {"text": "https://example.com", "link": "https://example.com"}, {"text": ">)"}]}]},
    {"name": "link target with parentheses ends at the first one", "in": "[a](https://example.com/a_(b)) tail", "out": [{"kind": "paragraph", "spans": [{"text": "a", "link": "https://example.com/a_(b"}, {"text": ") tail"}]}]},
    {"name": "emphasis hugging a word", "in": "*a*b and **a**b and a*b*c", "out": [{"kind": "paragraph", "spans": [{"text": "a", "italic": true}, {"text": "b and "}, {"text": "a", "bold": true}, {"text": "b and a"}, {"text": "b", "italic": true}, {"text": "c"}]}]},
    {"name": "underscore emphasis only at word edges", "in": "__init__.py and snake__case__name and a_b_c", "out": [{"kind": "paragraph", "spans": [{"text": "init", "bold": true}, {"text": ".py and snake_"}, {"text": "case", "italic": true}, {"text": "_name and a_b_c"}]}]},
    {"name": "underscore after an accented letter", "in": "café_x_ and cafe\u0301_y_ and ñ_z_", "out": [{"kind": "paragraph", "spans": [{"text": "café_x_ and cafe\u0301_y_ and ñ_z_"}]}]},
    {"name": "underscore before an accented letter", "in": "_x_é and _y_e\u0301", "out": [{"kind": "paragraph", "spans": [{"text": "_x_é and _y_e\u0301"}]}]},
    {"name": "bare url followed by a closing quote or comma", "in": "\"https://example.com/a\", and 'https://example.com/b'", "out": [{"kind": "paragraph", "spans": [{"text": "\""}, {"text": "https://example.com/a", "link": "https://example.com/a"}, {"text": "\", and '"}, {"text": "https://example.com/b", "link": "https://example.com/b"}, {"text": "'"}]}]},
    {"name": "bare url with non-latin path", "in": "https://例え.jp/パス end", "out": [{"kind": "paragraph", "spans": [{"text": "https://例え.jp/パス", "link": "https://例え.jp/パス"}, {"text": " end"}]}]},
    {"name": "bare url too short to be a link", "in": "http://a https://abc www.a www.ab.c", "out": [{"kind": "paragraph", "spans": [{"text": "http://a "}, {"text": "https://abc", "link": "https://abc"}, {"text": " "}, {"text": "www.a", "link": "https://www.a"}, {"text": " "}, {"text": "www.ab.c", "link": "https://www.ab.c"}]}]},
    {"name": "bare url inside brackets", "in": "[https://example.com/a](https://example.com/b) and <https://example.com/c>", "out": [{"kind": "paragraph", "spans": [{"text": "https://example.com/a", "link": "https://example.com/a"}, {"text": " and <"}, {"text": "https://example.com/c", "link": "https://example.com/c"}, {"text": ">"}]}]},
    {"name": "bare url with a query and fragment", "in": "https://example.com/a?b=1&c=2#top.", "out": [{"kind": "paragraph", "spans": [{"text": "https://example.com/a?b=1&c=2#top", "link": "https://example.com/a?b=1&c=2#top"}, {"text": "."}]}]},
    {"name": "email address is text", "in": "write to ana@example.com", "out": [{"kind": "paragraph", "spans": [{"text": "write to ana@example.com"}]}]},
    {"name": "ordered with non-ascii digits", "in": "٣. arabic\n１. wide\n1. ascii", "out": [{"kind": "paragraph", "spans": [{"text": "٣. arabic\n１. wide"}]}, {"kind": "ordered", "level": 0, "number": 1, "spans": [{"text": "ascii"}]}]},
    {"name": "indent with a non-breaking space", "in": "\u00a0- item\n\u00a0\u00a0- item two", "out": [{"kind": "bullet", "level": 0, "spans": [{"text": "item"}]}, {"kind": "bullet", "level": 0, "spans": [{"text": "item two"}]}]},
    {"name": "tab indent counts as two spaces", "in": "\t- one\n\t\t- two\n\t\t\t- three", "out": [{"kind": "bullet", "level": 1, "spans": [{"text": "one"}]}, {"kind": "bullet", "level": 2, "spans": [{"text": "two"}]}, {"kind": "bullet", "level": 2, "spans": [{"text": "three"}]}]},
    {"name": "trailing spaces and tabs are trimmed", "in": "text   \n- item \t\n> quote  ", "out": [{"kind": "paragraph", "spans": [{"text": "text"}]}, {"kind": "bullet", "level": 0, "spans": [{"text": "item"}]}, {"kind": "quote", "spans": [{"text": "quote"}]}]},
    {"name": "backslash before a letter is kept", "in": "C:\\temp\\new and \\\\ double", "out": [{"kind": "paragraph", "spans": [{"text": "C:\\temp\\new and \\ double"}]}]},
    {"name": "lone markers", "in": "* \n- \n> \n1. \n#", "out": [{"kind": "paragraph", "spans": [{"text": "*\n-"}]}, {"kind": "quote", "spans": []}, {"kind": "paragraph", "spans": [{"text": "1.\n#"}]}]},
    {"name": "code span holds a backtick run", "in": "`` a `` and ```not a fence``` mid line", "out": [{"kind": "paragraph", "spans": [{"text": "", "code": true}, {"text": " a "}, {"text": "", "code": true}, {"text": " and "}, {"text": "", "code": true}, {"text": "not a fence", "code": true}, {"text": "", "code": true}, {"text": " mid line"}]}]},
    {"name": "fence with trailing text", "in": "```python title=x\nprint(1)\n```", "out": [{"kind": "code", "text": "print(1)"}]},
    {"name": "emphasis spanning a line break", "in": "**bold\nacross** lines", "out": [{"kind": "paragraph", "spans": [{"text": "bold\nacross", "bold": true}, {"text": " lines"}]}]},
    {"name": "strike wrapping a link", "in": "~~[gone](https://example.com)~~", "out": [{"kind": "paragraph", "spans": [{"text": "gone", "strike": true, "link": "https://example.com"}]}]},
    {"name": "combining marks next to markers", "in": "**e\u0301** and *a\u0308*", "out": [{"kind": "paragraph", "spans": [{"text": "e\u0301", "bold": true}, {"text": " and "}, {"text": "a\u0308", "italic": true}]}]}
  ]
}
