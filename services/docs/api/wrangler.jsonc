// Template for wrangler.jsonc. Work through the `replace-with-…` values.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docs",
  "account_id": "replace-with-your-cloudflare-account-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request first, so /api/* never falls through to the SPA.
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Both are this Worker's own origin. auth.ts builds the Google redirect URI from PUBLIC_API_ORIGIN.
    "WEB_ORIGIN": "replace-with-your-docs-origin",
    "PUBLIC_API_ORIGIN": "replace-with-your-docs-origin",
    // Your Starlings origin. Staff pages redirect to its /docs.
    "MEET_WEB_ORIGIN": "replace-with-your-starlings-origin",
    "GOOGLE_WEB_CLIENT_ID": "replace-with-your-google-oauth-client-id",
    "EMAIL_FROM": "replace-with-your-sender-address",
    // `log` writes signing codes to the Worker log. Set `send` with POSTMARK_TOKEN: signers cannot sign without a code.
    "EMAIL_MODE": "log"
  },
  // Burst guards on the routes an anonymous caller can reach.
  "ratelimits": [
    { "name": "CLAIM_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGN_LIMIT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Your Starlings Worker, told of each guest view and link click.
  "services": [
    { "binding": "MEET", "service": "replace-with-your-starlings-worker", "entrypoint": "MemberService" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "docs", "database_id": "replace-with-your-d1-id", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "DOCS_FILES", "bucket_name": "docs-files" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
