// Template for wrangler.jsonc. Work through the `replace-with-…` values.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keep",
  "account_id": "replace-with-your-cloudflare-account-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request first, so /api/* never falls through to the SPA.
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Both are this Worker's own origin. A passkey binds to it, so changing it later breaks every enrolled passkey.
    "WEB_ORIGIN": "replace-with-your-keep-origin",
    "PUBLIC_API_ORIGIN": "replace-with-your-keep-origin",
    "GOOGLE_WEB_CLIENT_ID": "replace-with-your-google-oauth-client-id",
    "CORE_WEB_ORIGIN": "",
    // <team id>.<bundle id> of your signed apps, comma-separated. Empty: no native passkey association.
    "APPLE_APP_IDS": ""
  },
  // The one route that returns a ciphertext, per person.
  "ratelimits": [
    { "name": "REVEAL_LIMIT", "namespace_id": "3001", "simple": { "limit": 300, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "keep", "database_id": "replace-with-your-d1-id", "migrations_dir": "migrations" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
