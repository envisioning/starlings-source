.DS_Store
DerivedData/
DerivedData-*/
SignedDerivedData/
.build-app/
.build-app-release/
.build-ios-check/
.build-ios-device/
dist/
build/
*.xcuserstate
xcuserdata/
node_modules/
web/dist/
web/public/mediapipe/
*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts
.env
.env.*
!.env.example
*.xcresult
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Generated by scripts/version-env.sh — marketing + git commit count.
Config/Version.xcconfig
.release-secrets/

# Apple signing materials are only ever stored in the encrypted GitHub Actions
# secret store or a developer's secure local archive — never in this repo.
*.p12
*.p8
*.mobileprovision

# Local Xcode scratch / agent verify trees
.build-invite-test/
.derivedData-bandwidth/

# Xcode rewrites the shared scheme's launch action the moment anybody hits Run,
# so a tracked copy is permanently dirty for every developer. The file is
# generated anyway — `xcodegen generate` recreates it and
# scripts/configure-xcode-scheme.sh re-applies the GPU-capture fix — and every
# build path (pnpm verify, CI, release) runs xcodegen first.
Starlings.xcodeproj/xcshareddata/xcschemes/

# pnpm content-addressable cache, created by a store-dir run. Never source.
.pnpm-store/

# Claude Code session files
.claude/

# SwiftPM build output of the generated contracts package.
packages/contracts/swift/.build/

# A provisioning run's one-deploy Meet config (scripts/provision-workspace.mjs, meetFirst).
services/control-plane/wrangler.provision-*.jsonc
_worktrees/

# Supabase CLI cache, made by a supabase command run in this folder.
/supabase/.temp/
